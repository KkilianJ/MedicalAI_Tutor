# Optional. The simplest way to configure a real provider is to write the key
# directly in code, in medical_ai_tutor/local_settings.py (gitignored):
#
#     LLM_PROVIDER = "anthropic"
#     ANTHROPIC_API_KEY = "sk-ant-..."
#
# This file is the environment-variable alternative. Resolution order is:
#     local_settings.py  ->  environment  ->  .env  ->  config.yaml
# Copy to .env and fill in. Never commit real keys.

# Provider selection: mock | anthropic | openai
TUTOR_LLM_PROVIDER=mock

# Anthropic (preferred real provider)
ANTHROPIC_API_KEY=

# OpenAI-compatible provider (optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional overrides for config.yaml values
TUTOR_DEBUG_TRACING=true
TUTOR_DB_PATH=data/tutor.sqlite3
